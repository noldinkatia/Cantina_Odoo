<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========================================= -->
    <!-- LISTA DE PEDIDOS -->
    <!-- ========================================= -->

    <record id="view_cantina_order_list" model="ir.ui.view">
        <field name="name">cantina.order.list</field>
        <field name="model">cantina.order</field>
        <field name="arch" type="xml">
            <list string="Pedidos de empleados"
                  create="0"
                  delete="0"
                  decoration-muted="state == 'cancelled'"
                  decoration-success="payment_state == 'paid'">

                <field name="name"/>
                <field name="create_date"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="total"/>

                <field name="state"
                       widget="badge"
                       decoration-success="state == 'confirmed'"
                       decoration-danger="state == 'cancelled'"/>

                <field name="payment_state"
                       string="Estado de pago"
                       widget="badge"
                       decoration-success="payment_state == 'paid'"
                       decoration-warning="payment_state == 'unpaid'"/>

                <field name="payment_method_id" optional="show"/>
                <field name="paid_date" optional="hide"/>
                <field name="paid_by_id" optional="hide"/>

            </list>
        </field>
    </record>


    <!-- ========================================= -->
    <!-- FORMULARIO DEL PEDIDO -->
    <!-- ========================================= -->

    <record id="view_cantina_order_form" model="ir.ui.view">
        <field name="name">cantina.order.form</field>
        <field name="model">cantina.order</field>
        <field name="arch" type="xml">

            <form string="Pedido" create="0" delete="0">

                <header>

                    <button name="action_pay"
                            type="object"
                            string="Abrir Punto de Venta"
                            class="btn-primary"
                            groups="cantina_app.group_cantina_manager"
                            invisible="state != 'confirmed' or payment_state == 'paid'"/>

                    <button name="action_view_pos_order"
                            type="object"
                            string="Ver venta en Punto de Venta"
                            groups="cantina_app.group_cantina_manager"
                            invisible="not pos_order_id"/>

                    <field name="payment_state"
                           widget="statusbar"
                           statusbar_visible="unpaid,paid"/>

                </header>

                <sheet>

                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="department_id"/>
                        </group>

                        <group>
                            <field name="user_id"/>
                            <field name="create_date"/>
                            <field name="state"/>
                        </group>
                    </group>

                    <notebook>

                        <page string="Platos pedidos">

                            <field name="line_ids">

                                <list create="0"
                                      delete="0"
                                      edit="0">

                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="subtotal"/>

                                </list>

                            </field>

                        </page>

                        <page string="Información del pago"
                              invisible="payment_state != 'paid'">

                            <group>

                                <group>
                                    <field name="payment_method_id"/>
                                    <field name="amount_received"/>
                                    <field name="change_amount"/>
                                </group>

                                <group>
                                    <field name="paid_date"/>
                                    <field name="paid_by_id"/>
                                    <field name="pos_order_id"/>
                                </group>

                            </group>

                        </page>

                    </notebook>

                    <group>
                        <field name="total"/>
                    </group>

                </sheet>

            </form>

        </field>
    </record>


    <!-- ========================================= -->
    <!-- BUSCADOR Y FILTROS -->
    <!-- ========================================= -->

    <record id="view_cantina_order_search" model="ir.ui.view">
        <field name="name">cantina.order.search</field>
        <field name="model">cantina.order</field>
        <field name="arch" type="xml">

            <search string="Buscar pedidos">

                <field name="name"/>
                <field name="employee_id"/>
                <field name="department_id"/>

                <separator/>

                <filter name="unpaid"
                        string="Pendientes de pago"
                        domain="[('state', '=', 'confirmed'), ('payment_state', '=', 'unpaid')]"/>

                <filter name="paid"
                        string="Pagados"
                        domain="[('payment_state', '=', 'paid')]"/>

                <separator/>

                <filter name="group_department"
                        string="Departamento"
                        context="{'group_by': 'department_id'}"/>

                <filter name="group_payment"
                        string="Estado de pago"
                        context="{'group_by': 'payment_state'}"/>

                <filter name="group_method"
                        string="Medio de pago"
                        context="{'group_by': 'payment_method_id'}"/>

                <filter name="group_employee"
                        string="Empleado"
                        context="{'group_by': 'employee_id'}"/>

            </search>

        </field>
    </record>


    <!-- ========================================= -->
    <!-- ACCIÓN DE PEDIDOS -->
    <!-- ========================================= -->

    <record id="action_cantina_orders" model="ir.actions.act_window">

        <field name="name">Pedidos de empleados</field>
        <field name="res_model">cantina.order</field>
        <field name="view_mode">list,form</field>

        <!-- Mostrar todos los pedidos inicialmente -->
        <field name="context">{}</field>

    </record>


    <!-- ========================================= -->
    <!-- PANEL DEL EMPLEADO -->
    <!-- ========================================= -->

    <record id="action_cantina_employee_dashboard"
            model="ir.actions.client">

        <field name="name">Menú y pedidos</field>
        <field name="tag">cantina_app.employee_dashboard</field>

    </record>

</odoo>
