<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Parámetros -->
    <record id="view_cantina_config_form" model="ir.ui.view">
        <field name="name">cantina.config.form</field>
        <field name="model">cantina.config</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <header>
                    <button name="action_open_pos" type="object" string="Abrir caja"
                            class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="subtitle"/>
                        <field name="default_min_stock"/>
                    </group>
                    <group string="Cobros (Punto de Venta)">
                        <field name="pos_config_id" options="{'no_create': True}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cantina_config" model="ir.actions.server">
        <field name="name">Parámetros</field>
        <field name="model_id" ref="model_cantina_config"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open()</field>
    </record>

    <!-- Turnos -->
    <record id="view_cantina_shift_list" model="ir.ui.view">
        <field name="name">cantina.shift.list</field>
        <field name="model">cantina.shift</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="hour_from" widget="float_time"/>
                <field name="hour_to" widget="float_time"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="action_cantina_shift" model="ir.actions.act_window">
        <field name="name">Turnos</field>
        <field name="res_model">cantina.shift</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
